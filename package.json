{
  "name": "snappy-export-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Snappy: offline analysis tools for your Snapchat data export (Phase 1, no account access).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:dashboard": "npm run build -w @snappy-export/dashboard",
    "snappy-export": "node --experimental-strip-types --disable-warning=ExperimentalWarning apps/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
